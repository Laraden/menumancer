{
  "format": "menumancer.scene",
  "version": 3,
  "title": { "en": "Sliders for the user" },
  "loop": { "seconds": 10, "fps": 30 },
  "layers": [
    { "id": "sky", "type": "gradient", "angle": 90,
      "stops": [ { "at": 0, "color": "#0b1030" }, { "at": 1, "color": "#3a1f5c" } ] },
    { "id": "sun", "type": "gradient", "kind": "radial", "blend": "screen",
      "opacity": { "wave": "sine", "period": 5, "amp": 0.1, "base": 0.8 },
      "transform": { "offset": [0.3, 0.1], "scale": 0.4 },
      "stops": [ { "at": 0, "color": "#fff1c4" }, { "at": 1, "color": "#ff7a3000" } ] },
    { "id": "stars", "type": "procedural", "shader": "stars", "blend": "add", "params": { "density": 0.25 },
      "effects": [ { "id": "soft", "effect": "glow", "params": { "intensity": 1 } } ] }
  ],
  "exposed": [
    { "id": "sunGlow", "label": { "ru": "Солнце", "en": "Sun", "cs": "Slunce" }, "bind": "sun.opacity", "min": 0, "max": 1, "step": 0.05 },
    { "id": "starCount", "label": { "en": "Stars" }, "bind": "stars.params.density", "min": 0, "max": 1 },
    { "id": "starGlow", "label": { "en": "Star glow" }, "bind": "stars.effects.soft.params.intensity", "min": 0, "max": 2 },
    { "id": "zoom", "label": { "en": "Zoom" }, "bind": "camera.zoom", "min": 1, "max": 1.3, "step": 0.01 }
  ]
}
