{
  "format": "menumancer.scene",
  "version": 3,
  "title": { "en": "Particles" },
  "loop": { "seconds": 12, "fps": 30 },
  "layers": [
    { "id": "bg", "type": "color", "color": "#120a08" },
    { "id": "embers", "type": "particles", "preset": "embers", "depth": 0.8, "params": { "count": 60 } },
    { "id": "bubbles", "type": "particles", "blend": "add", "depth": 0.4,
      "system": {
        "count": 40,
        "spawn": { "kind": "bottom" },
        "life": { "min": 4, "max": 6 },
        "speed": { "min": 0.05, "max": 0.1 },
        "direction": -90,
        "spread": 20,
        "size": { "min": 0.01, "max": 0.02 },
        "color": [ { "at": 0, "color": "#7ae0ff" }, { "at": 1, "color": "#7ae0ff00" } ]
      } },
    { "id": "blizzard", "type": "color", "color": "#ffffff", "visible": false,
      "opacity": { "keys": [ { "t": 0, "v": 1 }, { "t": 4, "v": 1 }, { "t": 6, "v": 0.1 }, { "t": 10, "v": 0.1 } ], "period": 12 } },
    { "id": "snow", "type": "particles", "depth": 0.9,
      "params": { "count": { "script": "return 1500 * read('blizzard.opacity');", "inputs": ["blizzard.opacity"], "start": 1500 } },
      "system": { "count": 1500, "front": { "direction": 14, "speed": 0.8 } } },
    { "id": "gusts", "type": "particles", "depth": 0.7,
      "system": { "count": 2000, "wind": 1, "clumps": { "scale": 0.6, "amount": 0.9 } } }
  ]
}
