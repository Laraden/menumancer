{
  "format": "menumancer.scene",
  "version": 3,
  "title": { "en": "A reflection in water" },
  "loop": { "seconds": 8, "fps": 30 },
  "layers": [
    { "id": "sky", "type": "gradient", "angle": 90,
      "stops": [ { "at": 0, "color": "#1b2a4a" }, { "at": 1, "color": "#f2a65a" } ] },
    { "id": "water", "type": "backdrop", "size": [1.7777, 0.5], "flipY": true, "opacity": 0.8,
      "transform": { "offset": [0, 0.25] },
      "effects": [ { "id": "waves", "effect": "ripple", "params": { "mode": "waves", "cycles": 2 } } ] }
  ]
}
